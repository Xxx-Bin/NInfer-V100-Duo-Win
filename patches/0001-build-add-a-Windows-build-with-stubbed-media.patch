diff --git a/scripts/windows/build.cmd b/scripts/windows/build.cmd
new file mode 100644
index 00000000..c6530b04
--- /dev/null
+++ b/scripts/windows/build.cmd
@@ -0,0 +1,40 @@
+@echo off
+rem Build the native Windows tree configured by scripts\windows\configure.cmd.
+rem Usage: scripts\windows\build.cmd [target ...]
+setlocal
+set "ROOT=%~dp0..\.."
+for %%I in ("%ROOT%") do set "ROOT=%%~fI"
+set "CMAKE=%ROOT%\.tools\venv\Scripts\cmake.exe"
+set "VCVARS="
+
+if not exist "%CMAKE%" set "CMAKE=cmake"
+
+set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
+if exist "%VSWHERE%" (
+  for /f "usebackq tokens=*" %%I in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VS=%%I"
+)
+if defined VS set "VCVARS=%VS%\VC\Auxiliary\Build\vcvars64.bat"
+if not defined VCVARS set "VCVARS=C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars64.bat"
+if not exist "%VCVARS%" (
+  echo Could not find vcvars64.bat; install Visual Studio 2022 with the C++ workload.
+  exit /b 1
+)
+
+rem nvcc creates its temporaries through TMP/TEMP; keep them inside the tree, where the build
+rem user's token can always write, and where a failed compile leaves no debris in the user profile.
+set "NINFER_BUILD_TMP=%ROOT%\build-win-tmp"
+if not exist "%NINFER_BUILD_TMP%" mkdir "%NINFER_BUILD_TMP%"
+set "TMP=%NINFER_BUILD_TMP%"
+set "TEMP=%NINFER_BUILD_TMP%"
+set "VSLANG=1033"
+set "VSCMD_SKIP_SENDTELEMETRY=1"
+
+call "%VCVARS%" >nul
+if errorlevel 1 exit /b 1
+
+if "%~1"=="" (
+  "%CMAKE%" --build "%ROOT%\build-win" -j 8
+) else (
+  "%CMAKE%" --build "%ROOT%\build-win" -j 8 --target %*
+)
+exit /b %errorlevel%
diff --git a/scripts/windows/configure.cmd b/scripts/windows/configure.cmd
new file mode 100644
index 00000000..556c337c
--- /dev/null
+++ b/scripts/windows/configure.cmd
@@ -0,0 +1,65 @@
+@echo off
+rem Configure the native Windows build: MSVC 14.38, portable CUDA 12.8, sm_70, stubbed media.
+rem Usage: scripts\windows\configure.cmd [extra cmake args]
+setlocal
+set "ROOT=%~dp0..\.."
+for %%I in ("%ROOT%") do set "ROOT=%%~fI"
+set "CUDA=%ROOT%\_toolchain\cuda-12.8"
+set "CMAKE=%ROOT%\.tools\venv\Scripts\cmake.exe"
+set "NINJA=%ROOT%\.tools\venv\Scripts\ninja.exe"
+set "VCVARS="
+
+if not exist "%CMAKE%" set "CMAKE=cmake"
+if not exist "%NINJA%" set "NINJA=ninja"
+if not exist "%CUDA%\bin\nvcc.exe" (
+  echo Missing portable CUDA toolkit at "%CUDA%"
+  echo Run: python scripts\windows\fetch_cuda_toolkit.py
+  exit /b 1
+)
+
+rem Locate the Visual Studio installation that carries the C++ toolset instead of hard-coding an
+rem edition-specific path.
+set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
+if exist "%VSWHERE%" (
+  for /f "usebackq tokens=*" %%I in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VS=%%I"
+)
+if defined VS set "VCVARS=%VS%\VC\Auxiliary\Build\vcvars64.bat"
+if not defined VCVARS set "VCVARS=C:\Program Files\Microsoft Visual Studio\2022\Community\VC\Auxiliary\Build\vcvars64.bat"
+if not exist "%VCVARS%" (
+  echo Could not find vcvars64.bat; install Visual Studio 2022 with the C++ workload.
+  exit /b 1
+)
+
+rem nvcc writes intermediate files through TMP/TEMP. Keep them inside the build tree: the
+rem per-session temp directory can be read-only for toolchain children, and a failed compile then
+rem leaves no debris in the user profile.
+set "NINFER_BUILD_TMP=%ROOT%\build-win-tmp"
+if not exist "%NINFER_BUILD_TMP%" mkdir "%NINFER_BUILD_TMP%"
+set "TMP=%NINFER_BUILD_TMP%"
+set "TEMP=%NINFER_BUILD_TMP%"
+rem English tool output keeps CMake's MSVC include scanner deterministic; telemetry is off so a
+rem configure never waits on a network call.
+set "VSLANG=1033"
+set "VSCMD_SKIP_SENDTELEMETRY=1"
+call "%VCVARS%" >nul
+if errorlevel 1 exit /b 1
+
+rem FetchContent clones CUTLASS and then asks git to update its (empty) submodule list. Git for
+rem Windows runs that through MSYS sh, which cannot always create its shared-memory object. A
+rem pre-cloned checkout at _toolchain\cutlass lets FetchContent use the source in place; when it is
+rem absent the normal network download still applies.
+set "CUTLASS_SOURCE="
+if exist "%ROOT%\_toolchain\cutlass\CMakeLists.txt" (
+  set "CUTLASS_SOURCE=-DFETCHCONTENT_SOURCE_DIR_CUTLASS=%ROOT%\_toolchain\cutlass"
+)
+
+"%CMAKE%" -S "%ROOT%" -B "%ROOT%\build-win" -G Ninja ^
+  -DCMAKE_MAKE_PROGRAM="%NINJA%" ^
+  -DCMAKE_BUILD_TYPE=Release ^
+  -DCMAKE_CUDA_ARCHITECTURES=70 ^
+  -DCMAKE_CUDA_COMPILER="%CUDA%\bin\nvcc.exe" ^
+  -DCUDAToolkit_ROOT="%CUDA%" ^
+  -DNINFER_STUB_MEDIA=ON ^
+  %CUTLASS_SOURCE% ^
+  %*
+exit /b %errorlevel%
diff --git a/scripts/windows/fetch_cuda_toolkit.py b/scripts/windows/fetch_cuda_toolkit.py
new file mode 100644
index 00000000..c08068f2
--- /dev/null
+++ b/scripts/windows/fetch_cuda_toolkit.py
@@ -0,0 +1,113 @@
+"""Assemble a portable CUDA 12.8 toolkit from NVIDIA's redistributable archives.
+
+The project targets sm_70 (V100), and CUDA 13 removed Volta offline compilation, so 12.8 is the
+last usable toolkit. A normal toolkit install needs an elevated installer; this script instead
+downloads the four components the build actually consumes (nvcc, cudart, CCCL headers and NVTX)
+and merges them into ``_toolchain/cuda-12.8`` in the repository, which ``scripts/windows/
+configure.cmd`` then passes to CMake as ``CUDAToolkit_ROOT``.
+
+Usage:
+    python scripts/windows/fetch_cuda_toolkit.py [--force]
+"""
+
+from __future__ import annotations
+
+import argparse
+import os
+import shutil
+import sys
+import urllib.request
+import zipfile
+
+BASE = "https://developer.download.nvidia.com/compute/cuda/redist"
+COMPONENTS = [
+    "cuda_nvcc/windows-x86_64/cuda_nvcc-windows-x86_64-12.8.61-archive.zip",
+    "cuda_cudart/windows-x86_64/cuda_cudart-windows-x86_64-12.8.57-archive.zip",
+    "cuda_cccl/windows-x86_64/cuda_cccl-windows-x86_64-12.8.55-archive.zip",
+    "cuda_nvtx/windows-x86_64/cuda_nvtx-windows-x86_64-12.8.55-archive.zip",
+]
+# Only these top-level directories are merged from the secondary packages.
+MERGED_DIRS = {
+    "cuda_cudart": ("include", "lib"),
+    "cuda_cccl": ("include",),
+    "cuda_nvtx": ("include",),
+}
+REQUIRED = [
+    "bin/nvcc.exe",
+    "nvvm/libdevice/libdevice.10.bc",
+    "include/cuda_runtime.h",
+    "include/cuda.h",
+    "lib/x64/cudart.lib",
+    "lib/x64/cudart_static.lib",
+]
+
+
+def download(url: str, destination: str) -> None:
+    if os.path.exists(destination):
+        print(f"have {os.path.basename(destination)}")
+        return
+    partial = destination + ".part"
+    print(f"fetch {url}")
+    with urllib.request.urlopen(url, timeout=120) as response, open(partial, "wb") as out:
+        total = int(response.headers.get("Content-Length", 0))
+        done = 0
+        while True:
+            chunk = response.read(1 << 20)
+            if not chunk:
+                break
+            out.write(chunk)
+            done += len(chunk)
+            if total:
+                print(f"\r  {done / 1e6:.1f}/{total / 1e6:.1f} MB", end="", flush=True)
+    print()
+    os.replace(partial, destination)
+
+
+def merge(archive: str, root: str, subdirs: tuple[str, ...] | None) -> None:
+    with zipfile.ZipFile(archive) as bundle:
+        prefix = bundle.namelist()[0].split("/")[0]
+        for entry in bundle.namelist():
+            relative = entry[len(prefix) + 1 :]
+            if not relative:
+                continue
+            if subdirs is not None and relative.split("/")[0] not in subdirs:
+                continue
+            target = os.path.join(root, relative)
+            if entry.endswith("/"):
+                os.makedirs(target, exist_ok=True)
+                continue
+            os.makedirs(os.path.dirname(target), exist_ok=True)
+            with bundle.open(entry) as source, open(target, "wb") as destination:
+                shutil.copyfileobj(source, destination)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--force", action="store_true", help="re-extract over an existing tree")
+    args = parser.parse_args()
+
+    repo = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
+    cache = os.path.join(repo, "_toolchain", "downloads")
+    root = os.path.join(repo, "_toolchain", "cuda-12.8")
+    os.makedirs(cache, exist_ok=True)
+    if args.force:
+        shutil.rmtree(root, ignore_errors=True)
+    os.makedirs(root, exist_ok=True)
+
+    for component in COMPONENTS:
+        name = os.path.basename(component)
+        archive = os.path.join(cache, name)
+        download(f"{BASE}/{component}", archive)
+        package = name.split("-windows")[0]
+        merge(archive, root, MERGED_DIRS.get(package))
+
+    missing = [path for path in REQUIRED if not os.path.exists(os.path.join(root, path))]
+    if missing:
+        print("toolkit incomplete, missing:", ", ".join(missing), file=sys.stderr)
+        return 1
+    print(f"CUDA 12.8 toolkit ready at {root}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
