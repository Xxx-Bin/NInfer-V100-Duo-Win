 src/media/decode/decode_stub_win.cpp          |  39 ++++++
 .../media_acquire/acquire_stub_win.cpp        |  20 ++++
 tests/CMakeLists.txt                          |  26 ++--
 9 files changed, 345 insertions(+), 42 deletions(-)
