# Build
build/
build-*/
cmake-build-*/
*.o
*.obj
*.so
*.a
compile_commands.json
CMakeUserPresets.json
.cache/

# Local Windows port toolchain and scratch trees (never part of a commit). Anchor the build-tree
# pattern to the repository root: an unanchored `build-win*` also swallows any file whose name
# starts with it at any depth, including .github/workflows/build-windows.yml.
#
# The V100 port campaign's authoritative record lives in docs/notes/v100-port-campaign.md instead
# of here: one self-contained file carries the verdicts and numbers, so the raw measurement
# logs, planning docs and 6 MB of build spew under _scratch/port-log/ stay out of history.
_toolchain/
_ref/
_scratch/
probe/
/build-win*
vc140.pdb
*.exe
*.dll
*.pdb

# CUDA / profiling artifacts
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Python tooling
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Weight artifacts (large; produced by offline tooling)
*.qus
*.bin
*.safetensors
*.gguf
out/
*.log

# Measurement raw corpora & intermediates (large; produced by offline tooling).
# The small final frequency stats under fixtures/ranking/ ARE tracked; the rest is ignored.
tools/freq_corpus/fixtures/*
!tools/freq_corpus/fixtures/ranking/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
profiles/
.chatgpt/

# Claude Code personal/local settings (may contain API tokens)
.claude/settings.local.json

models/
*.ninfer
