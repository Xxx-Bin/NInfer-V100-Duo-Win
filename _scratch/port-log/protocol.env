# 移植战役唯一测量协议 —— 所有对比必须照此执行
# 基线 tag: baseline/port-study-34412f4
# 任何字段改动都等于换了一个实验，必须在 port-log 里注明

ARTIFACT=F:/models/ninfer/qwen3_8_27b_nvfp4.ninfer
CORPUS=bench/fixtures/bench_corpus.ids
# corpus 只有 65536 token，故用 60000（快照的 85K 在本 fork 无法复现）
PREFILL_TOKENS=60000
GEN_TOKENS=512
PREFILL_CHUNK=2560
KV_DTYPE=int8
MTP_DRAFT_TOKENS=4
LM_HEAD_DRAFT=--lm-head-draft
TP=2
DEVICES=0,1
REPEATS=2
WARMUP=1
CAPTURE_GENERATION=--capture-generation

# 判定门槛（事先定死，跑完不许改）
# 前置硬否决：输出 ID 序列 + 全部接受/草稿计数与基线逐一相同
# 例外：B 类（改求和/分组顺序）改用 queue-v2.md 8.1 的三段式判据
PREFILL_MIN_DELTA_PCT=1.0
DECODE_MIN_DELTA_PCT=0.5
SD_MULTIPLIER=2

# ---- 判定方式 v2（2026-10-25 用户调整，覆盖原"逐项当场删分支"流程）----
# 每项测完只做两件事：① 写结论到 port-log/<feat>.md；② "存起来"
# 存起来 = 【先 git commit】+ git tag result/<feat> + 保留分支 + 移除 worktree（省磁盘、回基线）
#   ！！第一步 commit 不能省：worktree 里未提交的改动会随 worktree remove --force 一起消失。
#   2026-10-25 已踩过一次：packet 的 +132 行没提交，移 worktree 后全部丢失，靠会话记录回放才救回。
#   提交后再核对 `git rev-parse result/<feat>` 必须等于新提交，**不能等于 34412f4f**（那就是基线）。
# 不在当场决定移除。整条队列跑完后，一次性汇总所有 result/* 的实测数字，统一裁决保留或删除。
# 允许这样做的前提：提交 + tag 把代码与 diff 完整冻结了；worktree 只是构建缓存。
# 注意：门槛判据本身不放宽，只是把"执行删除"的动作推迟到最后。

# ---- 档位基线（ladder tier）：依赖 packet 的项相对上一档测量 ----
# 每档记录 prefill/decode/oracle，依赖项的门槛 = 上一档 * (1+1.0% / 1+0.5%)
# tier0 = baseline/port-study-34412f4 : prefill 945.799  decode 129.727
# tier1 = result/packet-allreduce     : prefill 946.044  decode 135.804   (decode +4.685%, oracle 逐位一致)
#         => tier1 门槛：prefill >= 955.505、decode >= 136.483
TIER1_PREFILL_MIN=955.505
TIER1_DECODE_MIN=136.483

# 环境记录（每次测量填）
# gpu_temp_c_max=53   快照健康基线，超过需标注
# gpu_mem_before=     必须是空，否则作废

